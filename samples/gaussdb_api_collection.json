              "raw": "{\n  \"query_vector\": [0.1, 0.2, 0.3],\n  \"distance_metric\": \"cosine\",\n  \"vector_field\": \"embedding\",\n  \"limit\": 5,\n  \"where\": {\n    \"metadata->>difficulty:jsonb\": \"advanced\"\n  }\n}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data/_vector/search",
            "description": "向量搜索结合JSON字段过滤"
