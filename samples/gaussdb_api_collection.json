            "description": "清理大数字测试数据"
          }
        }
      ]
    },
    {
      "name": "7. 向量CRUD操作",
      "item": [
        {
          "name": "插入向量测试数据",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"向量测试文档\",\n  \"content\": \"这是一个向量测试文档\",\n  \"embedding\": [0.3, 0.4, 0.5],\n  \"category\": \"Test\",\n  \"metadata\": \"{\\\"tags\\\": [\\\"test\\\", \\\"vector\\\"]}\",\n  \"is_active\": true\n}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data",
            "description": "插入向量数据"
          }
        },
        {
          "name": "查询插入的向量数据",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data?title=$eq.向量测试文档",
            "description": "查询向量数据"
          }
        },
        {
          "name": "更新向量数据",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"embedding\": [0.6, 0.7, 0.8],\n  \"title\": \"更新后的向量文档\"\n}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data?title=$eq.向量测试文档",
            "description": "更新向量数据"
          }
        },
        {
          "name": "删除向量测试数据",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data?title=$eq.更新后的向量文档",
            "description": "删除向量测试数据"
          }
        }
      ]
    },
    {
      "name": "8. 向量相似性搜索",
      "item": [
        {
          "name": "余弦距离向量搜索",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query_vector\": [0.1, 0.2, 0.3],\n  \"distance_metric\": \"cosine\",\n  \"limit\": 3,\n  \"vector_field\": \"embedding\",\n  \"include_distance\": true\n}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data/_vector/search",
            "description": "使用余弦距离进行向量相似性搜索"
          }
        },
        {
          "name": "欧氏距离向量搜索",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query_vector\": [0.1, 0.2, 0.3],\n  \"distance_metric\": \"l2\",\n  \"vector_field\": \"embedding\",\n  \"limit\": 2\n}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data/_vector/search",
            "description": "使用欧氏距离进行向量相似性搜索"
          }
        },
        {
          "name": "内积距离向量搜索",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query_vector\": [0.1, 0.2, 0.3],\n  \"distance_metric\": \"inner\",\n  \"vector_field\": \"embedding\",\n  \"limit\": 2\n}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_vector_data/_vector/search",
            "description": "使用内积距离进行向量相似性搜索"
          }
        }
      ]
    },
    {
      "name": "9. 混合查询（向量+过滤条件）",
      "item": [
        {
          "name": "向量搜索+类别过滤",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
