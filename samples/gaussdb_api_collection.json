        },
        {
          "name": "清理特殊字符数据",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$eq.special@example.com",
            "description": "清理特殊字符测试数据"
          }
        },
        {
          "name": "插入大数字数据",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"大数字测试\",\"email\":\"bignumber@example.com\",\"age\":150,\"salary\":999999.99}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users",
            "description": "测试大数字处理"
          }
        },
        {
          "name": "清理大数字数据",
          "request": {
            "method": "DELETE",
