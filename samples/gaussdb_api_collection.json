{
  "info": {
    "name": "pREST GaussDB API",
    "description": "pREST REST API 测试集 - 针对 GaussDB 适配器",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "database",
      "value": "prest"
    },
    {
      "key": "schema",
      "value": "public"
    }
  ],
  "item": [
    {
      "name": "1. 系统信息查询",
      "item": [
        {
          "name": "健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/_health",
            "description": "检查 pREST 服务健康状态"
          }
        },
        {
          "name": "数据库列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/databases",
            "description": "获取所有数据库列表"
          }
        },
        {
          "name": "模式列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/schemas",
            "description": "获取所有模式列表"
          }
        },
        {
          "name": "所有表列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tables",
            "description": "获取所有表列表"
          }
        },
        {
          "name": "数据库模式列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}",
            "description": "获取特定数据库的模式列表"
          }
        },
        {
          "name": "查看表结构",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/show/{{database}}/{{schema}}/test_users",
            "description": "查看 test_users 表结构"
          }
        }
      ]
    },
    {
      "name": "2. CRUD操作",
      "item": [
        {
          "name": "插入测试数据",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"测试用户\",\"email\":\"test_crud@example.com\",\"age\":28,\"salary\":6000.00}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users",
            "description": "插入单条测试数据"
          }
        },
        {
          "name": "查询插入的数据",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$eq.test_crud@example.com",
            "description": "根据邮箱查询数据"
          }
        },
        {
          "name": "全量更新数据 (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"更新用户\",\"age\":29,\"salary\":6500.00}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$eq.test_crud@example.com",
            "description": "全量更新数据"
          }
        },
        {
          "name": "部分更新数据 (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"salary\":7000.00}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$eq.test_crud@example.com",
            "description": "部分更新数据"
          }
        },
        {
          "name": "删除测试数据",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$eq.test_crud@example.com",
            "description": "删除测试数据"
          }
        },
        {
          "name": "验证数据已删除",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$eq.test_crud@example.com",
            "description": "验证数据已删除"
          }
        },
        {
          "name": "批量插入数据",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[{\"name\":\"批量用户1\",\"email\":\"batch1@example.com\",\"age\":25,\"salary\":5000},{\"name\":\"批量用户2\",\"email\":\"batch2@example.com\",\"age\":30,\"salary\":8000}]"
            },
            "url": "{{baseUrl}}/batch/{{database}}/{{schema}}/test_users",
            "description": "批量插入多条数据"
          }
        },
        {
          "name": "清理批量数据",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$in.batch1@example.com,batch2@example.com",
            "description": "清理批量插入的测试数据"
          }
        }
      ]
    },
    {
      "name": "3. 查询功能",
      "item": [
        {
          "name": "基本查询",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users",
            "description": "查询所有数据"
          }
        },
        {
          "name": "过滤: 年龄大于25",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?age=$gt.25",
            "description": "过滤条件: 大于"
          }
        },
        {
          "name": "过滤: 工资小于7000",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?salary=$lt.7000",
            "description": "过滤条件: 小于"
          }
        },
        {
          "name": "多条件过滤",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?age=$gt.25&salary=$lt.8000",
            "description": "同时使用多个过滤条件"
          }
        },
        {
          "name": "按年龄降序排序",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?_order=-age",
            "description": "_order=-age 表示降序"
          }
        },
        {
          "name": "分页查询 (limit=2, offset=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?_limit=2&_offset=1",
            "description": "分页查询"
          }
        },
        {
          "name": "选择特定字段",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?_select=id,name,age",
            "description": "只返回指定字段"
          }
        },
        {
          "name": "计数查询",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?_count=*",
            "description": "返回记录总数"
          }
        }
      ]
    },
    {
      "name": "4. JSON功能",
      "item": [
        {
          "name": "插入JSON数据",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"metadata\":\"{\\\"department\\\":\\\"IT\\\",\\\"role\\\":\\\"developer\\\",\\\"skills\\\":[\\\"Go\\\",\\\"PostgreSQL\\\"]}\",\"tags\":[\"backend\",\"database\"]}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_json_data",
            "description": "插入包含JSON的数据"
          }
        },
        {
          "name": "查询JSON字段",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_json_data?metadata->>department:jsonb=IT",
            "description": "查询JSON字段中的值"
          }
        },
        {
          "name": "清理JSON测试数据",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_json_data?metadata->>department:jsonb=IT",
            "description": "清理JSON测试数据"
          }
        }
      ]
    },
    {
      "name": "5. 错误处理",
      "item": [
        {
          "name": "查询不存在的表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/nonexistent_table",
            "description": "期望返回 404"
          }
        },
        {
          "name": "查询不存在的字段",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?nonexistent_field=$eq.test",
            "description": "期望返回 400"
          }
        },
        {
          "name": "无效的查询语法",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?age=$invalid.25",
            "description": "期望返回 400"
          }
        },
        {
          "name": "插入冲突测试数据 (第一次)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"冲突测试\",\"email\":\"conflict@example.com\",\"age\":30,\"salary\":5000}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users",
            "description": "第一次插入"
          }
        },
        {
          "name": "插入冲突测试数据 (第二次，期望冲突)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"冲突测试\",\"email\":\"conflict@example.com\",\"age\":30,\"salary\":5000}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users",
            "description": "第二次插入，期望返回 400"
          }
        },
        {
          "name": "清理冲突测试数据",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users?email=$eq.conflict@example.com",
            "description": "清理冲突测试数据"
          }
        }
      ]
    },
    {
      "name": "6. 特殊情况",
