            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"测试&特殊<字符>\",\"email\":\"special@example.com\",\"age\":99,\"salary\":9999}"
            },
            "url": "{{baseUrl}}/{{database}}/{{schema}}/test_users",
            "description": "测试特殊字符处理"
